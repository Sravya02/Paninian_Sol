#include <algorithm>
#include <cmath>
#include <fstream>
#include <iomanip>
#include <iostream>
#include <limits>
#include <map>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>

using namespace std;

struct TelemetryRecord {
    double timestamp{};
    map<string, double> values;
    map<string, bool> valid;
};

struct SensorConfig {
    double physicalMin;
    double physicalMax;
    double operatingMin;
    double operatingMax;
    double trendThreshold;
};

struct Anomaly {
    double timestamp{};
    string sensor;
    double value{};
    string type;
    string description;
};

struct Statistics {
    size_t total{};
    size_t valid{};
    size_t missing{};
    size_t anomalies{};
    double minimum{};
    double maximum{};
    double average{};
};

const vector<string> SENSOR_NAMES = {
    "temp_c", "pressure_kpa", "altitude_m",
    "velocity_mps", "vibration_g", "accel_g"
};

const map<string, SensorConfig> CONFIG = {
    {"temp_c",      {-100.0, 200.0, -50.0, 120.0, 5.0}},
    {"pressure_kpa",{0.0, 2000.0, 100.0, 1200.0, 100.0}},
    {"altitude_m",  {-1000.0, 50000.0, 0.0, 45000.0, 1000.0}},
    {"velocity_mps",{0.0, 2000.0, 0.0, 1500.0, 100.0}},
    {"vibration_g", {0.0, 100.0, 0.0, 50.0, 10.0}},
    {"accel_g",     {-100.0, 100.0, -50.0, 50.0, 10.0}}
};

string trim(const string& s) {
    const string ws = " \t\r\n";
    const size_t first = s.find_first_not_of(ws);
    if (first == string::npos) return "";
    const size_t last = s.find_last_not_of(ws);
    return s.substr(first, last - first + 1);
}

vector<string> splitCSV(const string& line) {
    vector<string> fields;
    string field;
    bool quoted = false;

    for (char c : line) {
        if (c == '"') {
            quoted = !quoted;
        } else if (c == ',' && !quoted) {
            fields.push_back(field);
            field.clear();
        } else {
            field += c;
        }
    }
    fields.push_back(field);
    return fields;
}

bool parseNumber(const string& text, double& value) {
    const string s = trim(text);
    if (s.empty() || s == "NA" || s == "N/A" ||
        s == "null" || s == "NULL") {
        return false;
    }

    try {
        size_t consumed = 0;
        value = stod(s, &consumed);
        return consumed == s.size() && isfinite(value);
    } catch (...) {
        return false;
    }
}

class CSVReader {
public:
    vector<TelemetryRecord> read(const string& filename) const {
        ifstream input(filename);
        if (!input) {
            throw runtime_error("Cannot open input file: " + filename);
        }

        string line;
        if (!getline(input, line)) {
            throw runtime_error("Input CSV is empty.");
        }

        const vector<string> header = splitCSV(line);
        map<string, size_t> index;

        for (size_t i = 0; i < header.size(); ++i) {
            index[trim(header[i])] = i;
        }

        if (!index.count("timestamp")) {
            throw runtime_error("Required column 'timestamp' is missing.");
        }

        for (const string& sensor : SENSOR_NAMES) {
            if (!index.count(sensor)) {
                throw runtime_error("Required column '" + sensor + "' is missing.");
            }
        }

        vector<TelemetryRecord> records;
        size_t lineNumber = 1;

        while (getline(input, line)) {
            ++lineNumber;
            if (trim(line).empty()) continue;

            const vector<string> fields = splitCSV(line);
            double timestamp{};

            if (index["timestamp"] >= fields.size() ||
                !parseNumber(fields[index["timestamp"]], timestamp)) {
                cerr << "Warning: skipping invalid timestamp at line "
                     << lineNumber << '\n';
                continue;
            }

            TelemetryRecord record;
            record.timestamp = timestamp;

            for (const string& sensor : SENSOR_NAMES) {
                const size_t column = index[sensor];
                double value{};

                if (column < fields.size() && parseNumber(fields[column], value)) {
                    record.values[sensor] = value;
                    record.valid[sensor] = true;
                } else {
                    record.values[sensor] =
                        numeric_limits<double>::quiet_NaN();
                    record.valid[sensor] = false;
                }
            }

            records.push_back(record);
        }

        return records;
    }
};

class DataValidator {
public:
    void validate(vector<TelemetryRecord>& records) const {
        for (auto& record : records) {
            for (const string& sensor : SENSOR_NAMES) {
                if (!record.valid[sensor]) continue;

                const auto& limits = CONFIG.at(sensor);
                const double value = record.values[sensor];

                if (value < limits.physicalMin ||
                    value > limits.physicalMax) {
                    cerr << "Warning: physically invalid " << sensor
                         << " at timestamp " << record.timestamp << '\n';
                    record.valid[sensor] = false;
                    record.values[sensor] =
                        numeric_limits<double>::quiet_NaN();
                }
            }
        }
    }
};

class MissingValueHandler {
public:
    void interpolate(vector<TelemetryRecord>& records) const {
        for (const string& sensor : SENSOR_NAMES) {
            for (size_t i = 0; i < records.size(); ++i) {
                if (records[i].valid[sensor]) continue;

                int previous = -1;
                for (int j = static_cast<int>(i) - 1; j >= 0; --j) {
                    if (records[j].valid[sensor]) {
                        previous = j;
                        break;
                    }
                }

                size_t next = i + 1;
                while (next < records.size() &&
                       !records[next].valid[sensor]) {
                    ++next;
                }

                if (previous >= 0 && next < records.size()) {
                    const double t1 = records[previous].timestamp;
                    const double t2 = records[next].timestamp;
                    const double t = records[i].timestamp;
                    const double v1 = records[previous].values[sensor];
                    const double v2 = records[next].values[sensor];

                    records[i].values[sensor] =
                        (t2 == t1) ? v1 : v1 + (v2 - v1) * (t - t1) / (t2 - t1);
                    records[i].valid[sensor] = true;
                }
            }
        }
    }
};

vector<double> movingAverage(const vector<double>& values, size_t window = 3) {
    vector<double> result(values.size(), numeric_limits<double>::quiet_NaN());

    for (size_t i = 0; i < values.size(); ++i) {
        const size_t start = (i + 1 >= window) ? i + 1 - window : 0;
        double sum = 0.0;
        size_t count = 0;

        for (size_t j = start; j <= i; ++j) {
            if (isfinite(values[j])) {
                sum += values[j];
                ++count;
            }
        }

        if (count > 0) result[i] = sum / static_cast<double>(count);
    }
    return result;
}

class AnomalyDetector {
public:
    vector<Anomaly> detect(const vector<TelemetryRecord>& records) const {
        vector<Anomaly> anomalies;

        for (const string& sensor : SENSOR_NAMES) {
            vector<double> values;
            values.reserve(records.size());

            for (const auto& record : records) {
                values.push_back(record.values.at(sensor));
            }

            const vector<double> filtered = movingAverage(values);
            const auto& limits = CONFIG.at(sensor);

            for (size_t i = 0; i < records.size(); ++i) {
                if (!isfinite(filtered[i])) continue;

                if (filtered[i] < limits.operatingMin ||
                    filtered[i] > limits.operatingMax) {
                    anomalies.push_back({
                        records[i].timestamp, sensor, filtered[i],
                        "THRESHOLD",
                        "Filtered value outside operating limits"
                    });
                }

                if (i > 0 && isfinite(filtered[i - 1]) &&
                    abs(filtered[i] - filtered[i - 1]) > limits.trendThreshold) {
                    anomalies.push_back({
                        records[i].timestamp, sensor, filtered[i],
                        "TREND",
                        "Rapid change in filtered sensor value"
                    });
                }
            }
        }

        return anomalies;
    }
};

map<string, Statistics> calculateStatistics(
    const vector<TelemetryRecord>& records,
    const vector<Anomaly>& anomalies) {

    map<string, Statistics> result;

    for (const string& sensor : SENSOR_NAMES) {
        Statistics stats;
        stats.total = records.size();
        double sum = 0.0;

        for (const auto& record : records) {
            if (record.valid.at(sensor) &&
                isfinite(record.values.at(sensor))) {
                const double value = record.values.at(sensor);

                if (stats.valid == 0) {
                    stats.minimum = value;
                    stats.maximum = value;
                } else {
                    stats.minimum = min(stats.minimum, value);
                    stats.maximum = max(stats.maximum, value);
                }

                sum += value;
                ++stats.valid;
            } else {
                ++stats.missing;
            }
        }

        if (stats.valid > 0) {
            stats.average = sum / static_cast<double>(stats.valid);
        }

        for (const auto& anomaly : anomalies) {
            if (anomaly.sensor == sensor) ++stats.anomalies;
        }

        result[sensor] = stats;
    }

    return result;
}

void writeReport(
    const string& filename,
    const map<string, Statistics>& statistics,
    const vector<Anomaly>& anomalies) {

    ofstream output(filename);
    if (!output) {
        throw runtime_error("Cannot create report file: " + filename);
    }

    output << "Sensor,Total Samples,Valid Samples,Missing Samples,"
              "Minimum,Maximum,Average,Anomalies\n";
    output << fixed << setprecision(3);

    for (const auto& [sensor, stats] : statistics) {
        output << sensor << ','
               << stats.total << ','
               << stats.valid << ','
               << stats.missing << ','
               << stats.minimum << ','
               << stats.maximum << ','
               << stats.average << ','
               << stats.anomalies << '\n';
    }

    output << "\nTimestamp,Sensor,Value,Type,Description\n";
    for (const auto& anomaly : anomalies) {
        output << anomaly.timestamp << ','
               << anomaly.sensor << ','
               << anomaly.value << ','
               << anomaly.type << ','
               << anomaly.description << '\n';
    }
}

int main(int argc, char* argv[]) {
    if (argc < 2 || argc > 3) {
        cerr << "Usage: " << argv[0]
             << " <input.csv> [output_report.csv]\n";
        return 1;
    }

    const string inputFile = argv[1];
    const string outputFile =
        (argc == 3) ? argv[2] : "telemetry_report.csv";

    try {
        CSVReader reader;
        auto records = reader.read(inputFile);

        if (records.empty()) {
            throw runtime_error("No telemetry records were loaded.");
        }

        DataValidator validator;
        validator.validate(records);

        MissingValueHandler missingHandler;
        missingHandler.interpolate(records);

        AnomalyDetector detector;
        const auto anomalies = detector.detect(records);
        const auto statistics = calculateStatistics(records, anomalies);

        writeReport(outputFile, statistics, anomalies);

        cout << "Telemetry analysis completed successfully.\n";
        cout << "Records processed: " << records.size() << '\n';
        cout << "Anomalies detected: " << anomalies.size() << '\n';
        cout << "Report: " << outputFile << '\n';
    } catch (const exception& error) {
        cerr << "Error: " << error.what() << '\n';
        return 1;
    }

    return 0;
}
