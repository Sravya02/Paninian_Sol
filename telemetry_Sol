#include <algorithm>
#include <cmath>
#include <fstream>
#include <iomanip>
#include <iostream>
#include <limits>
#include <map>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>

using namespace std;

struct Record {
    double timestamp{};
    map<string,double> value;
    map<string,bool> valid;
};

struct Config {
    double physical_min, physical_max;
    double threshold_min, threshold_max;
    double trend_limit;
};

struct Finding {
    double timestamp{};
    string sensor, type, description;
    double raw_value{}, filtered_value{};
};

const vector<string> SENSORS = {
    "temp_c","pressure_kpa","altitude_m",
    "velocity_mps","vibration_g","accel_g"
};

/*
 * Screening limits are assignment limits, not certified aircraft limits.
 * Threshold detection is performed on raw values so that the reported
 * counts directly represent CSV samples. Trend detection uses filtered data.
 */
const map<string,Config> CONFIG = {
    {"temp_c",       {-100,200, -numeric_limits<double>::infinity(),40, 5}},
    {"pressure_kpa", {0,2000, -numeric_limits<double>::infinity(),numeric_limits<double>::infinity(), 0.50}},
    {"altitude_m",   {-1000,50000, -numeric_limits<double>::infinity(),numeric_limits<double>::infinity(), 5.0}},
    {"velocity_mps", {0,2000, -numeric_limits<double>::infinity(),350, 20}},
    {"vibration_g",  {0,100, -numeric_limits<double>::infinity(),0.10, 0.03}},
    {"accel_g",      {-100,100,0.90,1.10,0.10}}
};

vector<string> split_csv(const string& line) {
    vector<string> fields; string field; bool quoted=false;
    for(char c: line) {
        if(c=='"') quoted=!quoted;
        else if(c==',' && !quoted) { fields.push_back(field); field.clear(); }
        else field += c;
    }
    fields.push_back(field);
    return fields;
}

string trim(string s) {
    const string ws=" \t\r\n";
    size_t a=s.find_first_not_of(ws);
    if(a==string::npos) return "";
    size_t b=s.find_last_not_of(ws);
    return s.substr(a,b-a+1);
}

bool parse_number(const string& text, double& result) {
    string s=trim(text);
    if(s.empty() || s=="NA" || s=="N/A" || s=="null" || s=="NULL") return false;
    try {
        size_t used=0;
        result=stod(s,&used);
        return used==s.size() && isfinite(result);
    } catch(...) { return false; }
}

vector<Record> read_csv(const string& filename) {
    ifstream in(filename);
    if(!in) throw runtime_error("Cannot open input file: "+filename);

    string line;
    if(!getline(in,line)) throw runtime_error("CSV is empty");
    auto header=split_csv(line);
    map<string,size_t> index;
    for(size_t i=0;i<header.size();++i) index[trim(header[i])]=i;

    for(const string& s: SENSORS)
        if(!index.count(s)) throw runtime_error("Missing column: "+s);
    if(!index.count("timestamp")) throw runtime_error("Missing column: timestamp");

    vector<Record> records;
    while(getline(in,line)) {
        if(trim(line).empty()) continue;
        auto fields=split_csv(line);
        double t;
        if(index["timestamp"]>=fields.size() ||
           !parse_number(fields[index["timestamp"]],t)) {
            cerr<<"Warning: corrupted timestamp row skipped\n";
            continue;
        }

        Record r; r.timestamp=t;
        for(const string& s:SENSORS) {
            double v;
            size_t col=index[s];
            if(col<fields.size() && parse_number(fields[col],v)) {
                r.value[s]=v; r.valid[s]=true;
            } else {
                r.value[s]=numeric_limits<double>::quiet_NaN();
                r.valid[s]=false;
            }
        }
        records.push_back(r);
    }
    return records;
}

void validate(vector<Record>& records) {
    for(auto& r:records) {
        for(const string& s:SENSORS) {
            if(!r.valid[s]) continue;
            const auto& c=CONFIG.at(s);
            if(r.value[s]<c.physical_min || r.value[s]>c.physical_max) {
                r.valid[s]=false;
                r.value[s]=numeric_limits<double>::quiet_NaN();
            }
        }
    }
}

void interpolate(vector<Record>& records) {
    for(const string& s:SENSORS) {
        for(size_t i=0;i<records.size();++i) {
            if(records[i].valid[s]) continue;
            int prev=-1;
            for(int j=(int)i-1;j>=0;--j)
                if(records[j].valid[s]) { prev=j; break; }
            size_t next=i+1;
            while(next<records.size() && !records[next].valid[s]) ++next;

            if(prev>=0 && next<records.size()) {
                double t1=records[prev].timestamp, t2=records[next].timestamp;
                double v1=records[prev].value[s], v2=records[next].value[s];
                records[i].value[s]=(t2==t1)?v1:v1+(v2-v1)*(records[i].timestamp-t1)/(t2-t1);
                records[i].valid[s]=true;
            }
        }
    }
}

vector<double> moving_average(const vector<double>& x, size_t window=3) {
    vector<double> y(x.size(),numeric_limits<double>::quiet_NaN());
    for(size_t i=0;i<x.size();++i) {
        double sum=0; size_t n=0;
        size_t start=(i+1>=window)?i+1-window:0;
        for(size_t j=start;j<=i;++j) if(isfinite(x[j])) {sum+=x[j];++n;}
        if(n) y[i]=sum/n;
    }
    return y;
}

vector<Finding> detect(const vector<Record>& records) {
    vector<Finding> findings;
    for(const string& s:SENSORS) {
        vector<double> raw;
        for(const auto& r:records) raw.push_back(r.value.at(s));
        auto filtered=moving_average(raw);

        const auto& c=CONFIG.at(s);
        for(size_t i=0;i<records.size();++i) {
            if(!isfinite(raw[i])) continue;

            if(raw[i]<c.threshold_min || raw[i]>c.threshold_max)
                findings.push_back({records[i].timestamp,s,"THRESHOLD",
                    "Raw value outside configured screening limit",raw[i],filtered[i]});

            if(i>0 && isfinite(filtered[i]) && isfinite(filtered[i-1]) &&
               fabs(filtered[i]-filtered[i-1])>c.trend_limit)
                findings.push_back({records[i].timestamp,s,"TREND",
                    "Rapid change in filtered sensor value",raw[i],filtered[i]});
        }
    }
    return findings;
}

void write_report(const string& filename,const vector<Record>& records,
                  const vector<Finding>& findings) {
    ofstream out(filename);
    if(!out) throw runtime_error("Cannot create report");
    out<<"Sensor,Total Samples,Valid Samples,Missing Samples,Threshold Anomalies,Trend Anomalies,Total Findings\n";
    for(const string& s:SENSORS) {
        size_t valid=0, missing=0, th=0, tr=0;
        for(const auto& r:records) r.valid.at(s)?++valid:++missing;
        for(const auto& f:findings) if(f.sensor==s) f.type=="THRESHOLD"?++th:++tr;
        out<<s<<','<<records.size()<<','<<valid<<','<<missing<<','<<th<<','<<tr<<','<<th+tr<<'\n';
    }
    out<<"\nTimestamp,Sensor,Raw Value,Filtered Value,Type,Description\n";
    out<<fixed<<setprecision(3);
    for(const auto& f:findings)
        out<<f.timestamp<<','<<f.sensor<<','<<f.raw_value<<','<<f.filtered_value<<','<<f.type<<','<<f.description<<'\n';
}

int main(int argc,char* argv[]) {
    if(argc<2 || argc>3) {
        cerr<<"Usage: "<<argv[0]<<" input.csv [report.csv]\n"; return 1;
    }
    try {
        auto records=read_csv(argv[1]);
        size_t original_missing=0;
        for(const auto& r:records) for(const string& s:SENSORS) if(!r.valid.at(s)) ++original_missing;

        validate(records);
        interpolate(records);
        auto findings=detect(records);
        string report=(argc==3)?argv[2]:"telemetry_report.csv";
        write_report(report,records,findings);

        cout<<"Telemetry analysis completed successfully.\n";
        cout<<"Records processed: "<<records.size()<<'\n';
        cout<<"Original missing/corrupted sensor samples: "<<original_missing<<'\n';
        cout<<"Total findings: "<<findings.size()<<'\n';
        cout<<"Report: "<<report<<'\n';
    } catch(const exception& e) {
        cerr<<"Error: "<<e.what()<<'\n'; return 1;
    }
}
